{
  "name": "dinedesk",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=frontend",
    "check:backend": "node --check backend/src/index.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
