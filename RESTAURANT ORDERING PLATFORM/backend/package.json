    "schema": "src/prisma/schema.prisma",
    "seed": "node src/prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "5.7.1",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.22.3",
    "jsonwebtoken": "9.0.2",
    "socket.io": "4.8.4",
    "stripe": "14.10.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "prisma": "5.7.1"
  }
}
