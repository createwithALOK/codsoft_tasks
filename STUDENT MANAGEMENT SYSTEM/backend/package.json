{
  "name": "edumanage-backend",
  "version": "1.0.0",
  "description": "EduManage Student Management System - Backend API",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test",
    "db:migrate": "npx prisma migrate dev",
